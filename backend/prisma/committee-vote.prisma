model CommitteeVote {
  id String @id @default(cuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  round    Int
  memberId String
  decision VoteDecision
  comment  String?

  createdAt DateTime @default(now())

  @@unique([planId, round, memberId])
  @@index([planId])
  @@index([memberId])
}
