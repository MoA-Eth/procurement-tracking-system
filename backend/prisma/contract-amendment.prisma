// Append-only history of contract value changes.
// Never update Contract.totalValue directly — always insert a new amendment row.
model ContractAmendment {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  amendmentNo    Int     // 1, 2, 3... auto-incremented per contract
  previousValue  Decimal @db.Decimal(15, 2)
  newValue       Decimal @db.Decimal(15, 2)
  reason         String

  amendedById String
  amendedBy   User   @relation("ContractAmendedBy", fields: [amendedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([contractId, amendmentNo])
  @@index([contractId])
  @@index([amendedById])
}
