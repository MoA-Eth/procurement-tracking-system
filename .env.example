# Server-only URL used by Next.js route handlers and protected pages.
# MailerSend credentials belong only in the backend environment.
BACKEND_API_URL=http://localhost:5000
# Public origin used by server-side same-origin request validation.
APP_ORIGIN=http://localhost:3000
# Session cookie name for frontend authentication isolation
NEXT_PUBLIC_SESSION_COOKIE_NAME=moa_user_session
