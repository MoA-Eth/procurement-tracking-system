model Activity {
  id        String @id @default(uuid())
  reference String @unique

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  // Step 1 — Key Details
  procurementMethodId       String
  procurementMethod         LookupValue @relation("ActivityMethod", fields: [procurementMethodId], references: [id])
  specificMethod            String?
  marketApproach            String?
  qualificationApproach     String?
  domesticPreference        String?
  reviewType                String?
  oversightClassification   String?
  procurementProcess        String?
  evaluationOptions         String[]
  highSeaShRisk             Boolean?
  procurementDocumentType   String?
  contractType              String?
  requiresUnAgencyContracting Boolean?
  isImport                  Boolean     @default(false)

  // Step 2 — Related Information
  description               String?
  estimatedBudget           Float
  currency                  String?
  bidReferenceNo            String?
  pricingBasis              String?
  scopeNotes                String?
  remarks                   String?
  lotRequired               Boolean     @default(false)

  // Step 3 — Additional Details
  procurementClassificationCode String?
  procurementClassificationDesc String?
  location                  String?
  latitude                  Float?
  longitude                 Float?

  // Status & tracking
  contractId                String?
  processStatus             String?
  status                    ActivityStatus @default(PLANNED)
  performancePct            Float?

  createdById               String?
  creator                   User?          @relation("ActivityCreator", fields: [createdById], references: [id])

  updatedById               String?
  updatedByUser             User?          @relation("ActivityUpdater", fields: [updatedById], references: [id])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages    Stage[]
  contracts Contract[]
  documents Document[]
  lots      ActivityLot[]
  fundings  ActivityFunding[]
  components ActivityComponent[]
  revisions Revision[] @relation("RevisionActivity")

  @@index([planId])
  @@index([status])
  @@index([procurementMethodId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt, id])
}

model ActivityLot {
  id              String   @id @default(uuid())
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  lotNumber       String
  description     String?
  estimatedAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
}

model ActivityFunding {
  id              String   @id @default(uuid())
  activityId      String
  activity        Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fundingSource   String
  loanGrantNumber String?
  allocationPct   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
}

model ActivityComponent {
  id            String   @id @default(uuid())
  activityId    String
  activity      Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  component     String
  subcomponent  String?
  allocationPct Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
}
