model Plan {
  id                    String     @id @default(uuid())
  projectId             String
  project               Project    @relation(fields: [projectId], references: [id])
  
  title                 String
  budgetYear            String?
  procurementCategory   String?
  organization          String?
  description           String?
  
  periodStart           DateTime
  periodEnd             DateTime
  gpnDate               DateTime?
  
  status                PlanStatus @default(DRAFT)
  committeeRound        Int        @default(0)
  committeeVoteDeadline DateTime?

  createdBy String
  creator   User   @relation("PlanCreator", fields: [createdBy], references: [id])

  updatedById   String?
  updatedByUser User?     @relation("PlanUpdater", fields: [updatedById], references: [id])

  approvedById   String?
  approvedByUser User?     @relation("PlanApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?

  rejectedById    String?
  rejectedByUser  User?     @relation("PlanRejector", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  managementDecision      String?
  managementComment       String?
  managementById          String?
  managementByUser        User?     @relation("PlanManagementDecider", fields: [managementById], references: [id])
  managementAt            DateTime?
  directorRevisionComment String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities     Activity[]
  reviews        PlanReview[]
  committeeVotes CommitteeVote[]
  revisions      Revision[]          @relation("RevisionPlan")
  statusHistory  PlanStatusHistory[]

  @@index([projectId])
  @@index([status])
  @@index([createdBy])
  @@index([updatedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([managementById])
}

model PlanReview {
  id           String   @id @default(uuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewedById String
  reviewer     User     @relation(fields: [reviewedById], references: [id])
  notes        String
  createdAt    DateTime @default(now())

  @@index([planId])
  @@index([reviewedById])
}